<Project>
  <PropertyGroup>
    <!-- Thunderstore / Hexium package id — do not rename after publish -->
    <ThunderstoreName>BoardVikings_CardGames</ThunderstoreName>
    <ThunderstoreAuthor>DrakeMods</ThunderstoreAuthor>
    <RootNamespace>Cards</RootNamespace>
    <AssemblyName>BoardVikings-CardGames</AssemblyName>
    <Version>0.1.0-beta.1</Version>
    <BepInPluginName>BoardVikings-CardGames</BepInPluginName>
    <BepInGuid>com.DrakeMods.BoardVikings-CardGames</BepInGuid>
    <ModInfoClass>Cards</ModInfoClass>
    <Description>EARLY PREVIEW (beta), back up your world. Throw cards, build giant houses of cards, carry a deck in one item, hit the archery target, sit at a felt card table with chips and a dealer visor. DrakesMods: Board Vikings Cards.</Description>
    <WebsiteUrl></WebsiteUrl>
    <!-- Deploy DLL + Assets after PackageMod staging copies to output -->
    <DeployAfterTargets>CopyModAssetsToOutput</DeployAfterTargets>
  </PropertyGroup>
  <ItemGroup>
    <ThunderstoreDependency Include="denikson-BepInExPack_Valheim-5.4.2333" />
    <ThunderstoreDependency Include="ValheimModding-Jotunn-2.23.0" />
  </ItemGroup>
</Project>
