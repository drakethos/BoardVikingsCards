{
  "name": "C-06 icons are square (never stretched) and the card is real-card shaped and small in hand",
  "steps": [
    {
      "do": "teleport",
      "x": -6,
      "z": -8.5,
      "yaw": 218
    },
    {
      "do": "setconfig",
      "guid": "com.drakemods.serverteams",
      "values": {
        "4 Visuals/TeamGlow": false
      }
    },
    {
      "do": "give",
      "prefab": "ArmorLeatherLegs",
      "equip": true
    },
    {
      "do": "give",
      "prefab": "ArmorLeatherChest",
      "equip": true
    },
    {
      "do": "invoke",
      "method": "Cards.CardsTestApi.TestSquareIcons",
      "args": [
        "throw"
      ]
    },
    {
      "do": "check",
      "check": "lastResult",
      "label": "all 53 throwing icons square",
      "expect": 53
    },
    {
      "do": "invoke",
      "method": "Cards.CardsTestApi.TestSquareIcons",
      "args": [
        "play"
      ]
    },
    {
      "do": "check",
      "check": "lastResult",
      "label": "all 53 playing icons square",
      "expect": 53
    },
    {
      "do": "invoke",
      "method": "Cards.CardsTestApi.TestCardShape",
      "args": []
    },
    {
      "do": "check",
      "check": "lastResult",
      "label": "card is about 5:7 (0.6 - 0.8)",
      "min": 0.6,
      "max": 0.8
    },
    {
      "do": "invoke",
      "method": "Cards.CardsTestApi.TestHeldSize",
      "args": []
    },
    {
      "do": "check",
      "check": "lastResult",
      "label": "held card is at most 30 cm",
      "min": 0.05,
      "max": 0.3
    }
  ],
  "asserts": [
    {
      "check": "noErrors",
      "source": "BoardVikings-CardGames",
      "label": "no errors from the card mod"
    },
    {
      "check": "noErrors",
      "label": "no errors from anyone"
    }
  ]
}