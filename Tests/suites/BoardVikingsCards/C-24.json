{
  "name": "C-24 card table: the panel shows my hand, the piles and the dealer tools",
  "steps": [
    {
      "do": "teleport",
      "x": -6,
      "z": -8.5,
      "yaw": 218
    },
    {
      "do": "setconfig",
      "guid": "com.drakemods.serverteams",
      "values": {
        "4 Visuals/TeamGlow": false
      }
    },
    {
      "do": "give",
      "prefab": "ArmorLeatherLegs",
      "equip": true
    },
    {
      "do": "give",
      "prefab": "ArmorLeatherChest",
      "equip": true
    },
    {
      "do": "spawn",
      "prefab": "Card_Table_Long",
      "dz": 5,
      "as": "t"
    },
    {
      "do": "wait",
      "seconds": 1
    },
    {
      "do": "invoke",
      "method": "Cards.Table.TableTestApi.TestSetSeats",
      "args": [
        4
      ]
    },
    {
      "do": "invoke",
      "method": "Cards.Table.TableTestApi.TestSit",
      "args": [
        1
      ]
    },
    {
      "do": "give",
      "prefab": "Card_Deck",
      "count": 1
    },
    {
      "do": "invoke",
      "method": "Cards.Table.TableTestApi.TestPlaceDeck",
      "args": []
    },
    {
      "do": "invoke",
      "method": "Cards.Table.TableTestApi.TestDeal",
      "args": [
        5
      ]
    },
    {
      "do": "invoke",
      "method": "Cards.Table.TableTestApi.TestPlay",
      "args": [
        0,
        true
      ]
    },
    {
      "do": "invoke",
      "method": "Cards.Table.TableTestApi.TestOpenPanel",
      "args": []
    },
    {
      "do": "wait",
      "seconds": 0.8
    },
    {
      "do": "screenshot",
      "name": "table-panel-hand",
      "clean": true
    },
    {
      "do": "pressKey",
      "key": "Escape"
    }
  ],
  "asserts": [
    {
      "check": "noErrors",
      "source": "BoardVikings-CardGames",
      "label": "no errors from the card mod"
    },
    {
      "check": "noErrors",
      "label": "no errors from anyone"
    }
  ]
}