    {
      "do": "wait",
      "seconds": 1.5
    },
    {
      "do": "invoke",
      "method": "Cards.Table.TableTestApi.TestCameraAround",
      "args": [
        180
      ]
    },
    {
      "do": "wait",
      "seconds": 1.2
    },
    {
      "do": "screenshot",
      "name": "visor-front",
      "clean": true
    },
    {
      "do": "invoke",
      "method": "Cards.Table.TableTestApi.TestCameraAround",
      "args": [
        90
      ]
    },
    {
      "do": "wait",
      "seconds": 1.2
    },
    {
      "do": "screenshot",
      "name": "visor-side",
      "clean": true
    },
    {
      "do": "invoke",
      "method": "Cards.Table.TableTestApi.TestCameraAround",
      "args": [
        0
      ]
    }
  ],
  "asserts": [
    {
      "check": "noErrors",
      "source": "BoardVikings-CardGames",
      "label": "no errors from the card mod"
    },
    {
      "check": "noErrors",
      "label": "no errors from anyone"
    }
  ]
