{
  "name": "C-27 dealer visor: how it looks on the head (front and side)",
  "steps": [
    {
      "do": "teleport",
      "x": -6,
      "z": -8.5,
      "yaw": 218
    },
    {
      "do": "setconfig",
      "guid": "com.drakemods.serverteams",
      "values": {
        "4 Visuals/TeamGlow": false
      }
    },
    {
      "do": "give",
      "prefab": "ArmorLeatherLegs",
      "equip": true
    },
    {
      "do": "give",
      "prefab": "ArmorLeatherChest",
      "equip": true
    },
    {
      "do": "invoke",
      "method": "Cards.Table.TableTestApi.TestWearVisor",
      "args": []
    },
    {
      "do": "check",
      "check": "lastResult",
      "label": "the visor is on",
      "expect": true
