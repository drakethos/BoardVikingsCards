{
  "name": "C-10 giant card: tilt leans the card without turning it, and the build-mode patches are active",
  "steps": [
    {
      "do": "teleport",
      "x": -6,
      "z": -8.5,
      "yaw": 218
    },
    {
      "do": "setconfig",
      "guid": "com.drakemods.serverteams",
      "values": {
        "4 Visuals/TeamGlow": false
      }
    },
    {
      "do": "give",
      "prefab": "ArmorLeatherLegs",
      "equip": true
    },
    {
      "do": "give",
      "prefab": "ArmorLeatherChest",
      "equip": true
    },
    {
      "do": "invoke",
      "method": "Cards.Giant.GiantCardApi.TestTiltPatched",
      "args": []
    },
    {
      "do": "check",
      "check": "lastResult",
      "label": "tilt is hooked into build mode",
      "expect": true
    },
    {
      "do": "invoke",
      "method": "Cards.Giant.GiantCardApi.TestOrientationLean",
      "args": [
        0,
        30
      ]
    },
    {
      "do": "check",
      "check": "lastResult",
      "label": "leans 30 degrees",
      "expect": 30
    },
    {
      "do": "invoke",
      "method": "Cards.Giant.GiantCardApi.TestOrientationLean",
      "args": [
        90,
        45
      ]
    },
    {
      "do": "check",
      "check": "lastResult",
      "label": "leans 45 degrees at any facing",
      "expect": 45
    },
    {
      "do": "invoke",
      "method": "Cards.Giant.GiantCardApi.TestOrientationYaw",
      "args": [
        90,
        40
      ]
    },
    {
      "do": "check",
      "check": "lastResult",
      "label": "still faces the same way when tilted",
      "expect": 90
    },
    {
      "do": "invoke",
      "method": "Cards.Giant.GiantCardApi.TestOrientationYaw",
      "args": [
        200,
        40
      ]
    },
    {
      "do": "check",
      "check": "lastResult",
      "label": "still faces the same way (other facing)",
      "expect": 200
    }
  ],
  "asserts": [
    {
      "check": "noErrors",
      "source": "BoardVikings-CardGames",
      "label": "no errors from the card mod"
    },
    {
      "check": "noErrors",
      "label": "no errors from anyone"
    }
  ]
}