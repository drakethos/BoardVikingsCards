{
  "name": "C-23 card table: put a deck on, deal, play, discard, draw, flip, collect, pick the deck up again",
  "steps": [
    {
      "do": "teleport",
      "x": -6,
      "z": -8.5,
      "yaw": 218
    },
    {
      "do": "setconfig",
      "guid": "com.drakemods.serverteams",
      "values": {
        "4 Visuals/TeamGlow": false
      }
    },
    {
      "do": "give",
      "prefab": "ArmorLeatherLegs",
      "equip": true
    },
    {
      "do": "give",
      "prefab": "ArmorLeatherChest",
      "equip": true
    },
    {
      "do": "spawn",
      "prefab": "Card_Table_Long",
      "dz": 5,
      "as": "t"
    },
    {
      "do": "wait",
      "seconds": 1
    },
    {
      "do": "invoke",
      "method": "Cards.Table.TableTestApi.TestSetSeats",
      "args": [
        4
      ]
    },
    {
      "do": "invoke",
      "method": "Cards.Table.TableTestApi.TestSit",
      "args": [
        1
      ]
    },
    {
      "do": "check",
      "check": "lastResult",
      "label": "sat in seat 1",
      "expect": 1
    },
    {
      "do": "give",
      "prefab": "Card_Deck",
      "count": 1
    },
    {
      "do": "invoke",
      "method": "Cards.Table.TableTestApi.TestPlaceDeck",
      "args": []
    },
    {
      "do": "check",
      "check": "lastResult",
      "label": "the whole deck is on the table",
      "expect": 52
    },
    {
      "do": "invoke",
      "method": "Cards.Table.TableTestApi.TestShuffle",
      "args": []
    },
    {
      "do": "check",
      "check": "lastResult",
      "label": "shuffled, still 52",
      "expect": 52
    },
    {
      "do": "invoke",
      "method": "Cards.Table.TableTestApi.TestDeal",
      "args": [
        5
      ]
    },
    {
      "do": "check",
      "check": "lastResult",
      "label": "dealt 5 to the one player seated",
      "expect": 47
    },
    {
      "do": "invoke",
      "method": "Cards.Table.TableTestApi.TestHand",
      "args": []
    },
    {
      "do": "check",
      "check": "lastResult",
      "label": "my hand has 5 cards",
      "expect": 5
    },
    {
      "do": "invoke",
      "method": "Cards.Table.TableTestApi.TestCardObjects",
      "args": []
    },
    {
      "do": "check",
      "check": "lastResult",
      "label": "the table shows its cards",
      "min": 6
    },
    {
      "do": "invoke",
      "method": "Cards.Table.TableTestApi.TestPlay",
      "args": [
        0,
        true
      ]
    },
    {
      "do": "check",
      "check": "lastResult",
      "label": "one card on the felt",
      "expect": 1
    },
    {
      "do": "invoke",
      "method": "Cards.Table.TableTestApi.TestDiscard",
      "args": [
        0
      ]
    },
    {
      "do": "check",
      "check": "lastResult",
      "label": "one card discarded",
      "expect": 1
    },
    {
      "do": "invoke",
      "method": "Cards.Table.TableTestApi.TestDraw",
      "args": []
    },
    {
      "do": "check",
      "check": "lastResult",
      "label": "drew one: 5 - 2 + 1 cards in hand",
      "expect": 4
    },
    {
      "do": "invoke",
      "method": "Cards.Table.TableTestApi.TestFlip",
      "args": [
        0
      ]
    },
    {
      "do": "check",
      "check": "lastResult",
      "label": "turned a card face up",
      "expect": true
    },
    {
      "do": "invoke",
      "method": "Cards.Table.TableTestApi.TestCardTotal",
      "args": []
    },
    {
      "do": "check",
      "check": "lastResult",
      "label": "no card lost or added",
      "expect": 52
    },
    {
      "do": "invoke",
      "method": "Cards.Table.TableTestApi.TestWearVisor",
      "args": []
    },
    {
      "do": "lookAt",
      "target": "t",
      "distance": 3.2
    },
    {
      "do": "wait",
      "seconds": 0.5
    },
    {
      "do": "screenshot",
      "name": "table-dealt",
      "clean": true
    },
    {
      "do": "invoke",
      "method": "Cards.Table.TableTestApi.TestGrab",
      "args": [
        0
      ]
    },
    {
      "do": "check",
      "check": "lastResult",
      "label": "picked the played card back up",
      "expect": 5
    },
    {
      "do": "invoke",
      "method": "Cards.Table.TableTestApi.TestCollect",
      "args": []
    },
    {
      "do": "check",
      "check": "lastResult",
      "label": "everything collected into the deck",
      "expect": 52
    },
    {
      "do": "invoke",
      "method": "Cards.Table.TableTestApi.TestTakeDeck",
      "args": []
    },
    {
      "do": "check",
      "check": "lastResult",
      "label": "I picked the deck up: a deck item with 52 cards",
      "expect": 52
    },
    {
      "do": "invoke",
      "method": "Cards.Table.TableTestApi.TestDeckCount",
      "args": []
    },
    {
      "do": "check",
      "check": "lastResult",
      "label": "the table has no deck now",
      "expect": 0
    }
  ],
  "asserts": [
    {
      "check": "hasItem",
      "prefab": "Card_Deck",
      "count": 1,
      "label": "the deck is in my inventory again"
    },
    {
      "check": "noErrors",
      "source": "BoardVikings-CardGames",
      "label": "no errors from the card mod"
    },
    {
      "check": "noErrors",
      "label": "no errors from anyone"
    }
  ]
}