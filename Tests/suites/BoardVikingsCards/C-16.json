{
  "name": "C-16 throwing a card: it flies a spear-like distance, keeps its face, and lands as an item",
  "steps": [
    {
      "do": "teleport",
      "x": -6,
      "z": -8.5,
      "yaw": 218
    },
    {
      "do": "setconfig",
      "guid": "com.drakemods.serverteams",
      "values": {
        "4 Visuals/TeamGlow": false
      }
    },
    {
      "do": "give",
      "prefab": "ArmorLeatherLegs",
      "equip": true
    },
    {
      "do": "give",
      "prefab": "ArmorLeatherChest",
      "equip": true
    },
    {
      "do": "invoke",
      "method": "Cards.Table.TableTestApi.TestWearVisor",
      "args": []
    },
    {
      "do": "invoke",
      "method": "Cards.CardsTestApi.TestProbeThrow",
      "args": [
        true
      ]
    },
    {
      "do": "invoke",
      "method": "Cards.CardsTestApi.TestEquipThrowing",
      "args": [
        "SK"
      ]
    },
    {
      "do": "check",
      "check": "lastResult",
      "label": "holding the King of Spades",
      "expect": true
    },
    {
      "do": "wait",
      "seconds": 1
    },
    {
      "do": "screenshot",
      "name": "holding-card",
      "clean": true
    },
    {
      "do": "pressKey",
      "button": "Attack"
    },
    {
      "do": "wait",
      "seconds": 5
    },
    {
      "do": "screenshot",
      "name": "after-throw",
      "clean": true
    },
    {
      "do": "invoke",
      "method": "Cards.CardsTestApi.TestThrowDistance",
      "args": []
    },
    {
      "do": "check",
      "check": "lastResult",
      "label": "flew at least 5 m (not dropped at my feet)",
      "min": 5
    },
    {
      "do": "invoke",
      "method": "Cards.CardsTestApi.TestLandedFace",
      "args": []
    },
    {
      "do": "check",
      "check": "lastResult",
      "label": "the landed card is still the King of Spades",
      "expect": "SK"
    }
  ],
  "asserts": [
    {
      "check": "noItem",
      "prefab": "Card_Throwing",
      "label": "card left the inventory"
    },
    {
      "check": "noErrors",
      "source": "BoardVikings-CardGames",
      "label": "no errors from the card mod"
    },
    {
      "check": "noErrors",
      "label": "no errors from anyone"
    }
  ]
}