{
  "name": "C-17 archery target: thrown cards score, stay stuck in it, and come back with their own faces",
  "steps": [
    {
      "do": "teleport",
      "x": -6,
      "z": -8.5,
      "yaw": 218
    },
    {
      "do": "invoke",
      "method": "Cards.CardsTestApi.TestClearThrown",
      "args": []
    },
    {
      "do": "spawn",
      "prefab": "piece_ArcheryTarget",
      "dz": 4,
      "as": "t"
    },
    {
      "do": "wait",
      "seconds": 1
    },
    {
      "do": "invoke",
      "method": "Cards.CardsTestApi.TestEquipThrowing",
      "args": [
        "SK"
      ]
    },
    {
      "do": "wait",
      "seconds": 0.6
    },
    {
      "do": "lookAt",
      "target": "t",
      "distance": 5
    },
    {
      "do": "wait",
      "seconds": 0.3
    },
    {
      "do": "pressKey",
      "button": "Attack"
    },
    {
      "do": "wait",
      "seconds": 2.2
    },
    {
      "do": "invoke",
      "method": "Cards.CardsTestApi.TestEquipThrowing",
      "args": [
        "HQ"
      ]
    },
    {
      "do": "wait",
      "seconds": 0.6
    },
    {
      "do": "lookAt",
      "target": "t",
      "distance": 5
    },
    {
      "do": "wait",
      "seconds": 0.3
    },
    {
      "do": "pressKey",
      "button": "Attack"
    },
    {
      "do": "wait",
      "seconds": 2.2
    },
    {
      "do": "invoke",
      "method": "Cards.CardsTestApi.TestEquipThrowing",
      "args": [
        "D7"
      ]
    },
    {
      "do": "wait",
      "seconds": 0.6
    },
    {
      "do": "lookAt",
      "target": "t",
      "distance": 5
    },
    {
      "do": "wait",
      "seconds": 0.3
    },
    {
      "do": "pressKey",
      "button": "Attack"
    },
    {
      "do": "wait",
      "seconds": 2.2
    },
    {
      "do": "screenshot",
      "name": "cards-in-target"
    },
    {
      "do": "invoke",
      "method": "Cards.CardsTestApi.TestTargetHits",
      "args": []
    },
    {
      "do": "check",
      "check": "lastResult",
      "label": "all three cards hit the target",
      "min": 3
    },
    {
      "do": "invoke",
      "method": "Cards.CardsTestApi.TestTargetScore",
      "args": []
    },
    {
      "do": "check",
      "check": "lastResult",
      "label": "they scored points",
      "min": 1
    },
    {
      "do": "invoke",
      "method": "Cards.CardsTestApi.TestTargetFaces",
      "args": []
    },
    {
      "do": "check",
      "check": "lastResult",
      "label": "the target remembers each face in order",
      "expect": "SK,HQ,D7"
    },
    {
      "do": "face",
      "target": "t"
    },
    {
      "do": "interact",
      "target": "t"
    },
    {
      "do": "wait",
      "seconds": 1.5
    },
    {
      "do": "invoke",
      "method": "Cards.CardsTestApi.TestTargetHits",
      "args": []
    },
    {
      "do": "check",
      "check": "lastResult",
      "label": "pressing E collected them (score reset)",
      "expect": 0
    },
    {
      "do": "screenshot",
      "name": "cards-returned"
    },
    {
      "do": "invoke",
      "method": "Cards.CardsTestApi.TestNearbyFaces",
      "args": [
        12
      ]
    },
    {
      "do": "check",
      "check": "lastResult",
      "label": "the same three cards came back, each with its own face",
      "expect": "D7,HQ,SK"
    }
  ],
  "asserts": [
    {
      "check": "noErrors",
      "source": "BoardVikings-CardGames",
      "label": "no errors from the card mod"
    },
    {
      "check": "noErrors",
      "label": "no errors from anyone"
    }
  ]
}