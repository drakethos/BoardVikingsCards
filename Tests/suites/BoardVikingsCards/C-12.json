{
  "name": "C-12 giant card: the back design is chosen separately, and the next card copies the last pick",
  "steps": [
    {
      "do": "teleport",
      "x": -6,
      "z": -8.5,
      "yaw": 218
    },
    {
      "do": "setconfig",
      "guid": "com.drakemods.serverteams",
      "values": {
        "4 Visuals/TeamGlow": false
      }
    },
    {
      "do": "give",
      "prefab": "ArmorLeatherLegs",
      "equip": true
    },
    {
      "do": "give",
      "prefab": "ArmorLeatherChest",
      "equip": true
    },
    {
      "do": "invoke",
      "method": "Cards.Giant.GiantCardApi.TestResetNext",
      "args": []
    },
    {
      "do": "spawn",
      "prefab": "Card_Giant",
      "dz": 5,
      "as": "first"
    },
    {
      "do": "wait",
      "seconds": 1
    },
    {
      "do": "invoke",
      "method": "Cards.Giant.GiantCardApi.TestBack",
      "args": []
    },
    {
      "do": "check",
      "check": "lastResult",
      "label": "a new card starts with the default back (red lattice)",
      "expect": 3
    },
    {
      "do": "invoke",
      "method": "Cards.Giant.GiantCardApi.TestSetBack",
      "args": [
        10
      ]
    },
    {
      "do": "check",
      "check": "lastResult",
      "label": "back picked",
      "expect": true
    },
    {
      "do": "invoke",
      "method": "Cards.Giant.GiantCardApi.TestBack",
      "args": []
    },
    {
      "do": "check",
      "check": "lastResult",
      "label": "back is design 10",
      "expect": 10
    },
    {
      "do": "invoke",
      "method": "Cards.Giant.GiantCardApi.TestNextBack",
      "args": []
    },
    {
      "do": "check",
      "check": "lastResult",
      "label": "the next card will copy it",
      "expect": 10
    },
    {
      "do": "spawn",
      "prefab": "Card_Giant",
      "dz": 2,
      "dx": 2,
      "as": "second"
    },
    {
      "do": "wait",
      "seconds": 1
    },
    {
      "do": "invoke",
      "method": "Cards.Giant.GiantCardApi.TestBack",
      "args": []
    },
    {
      "do": "check",
      "check": "lastResult",
      "label": "the card placed next has the same back",
      "expect": 10
    }
  ],
  "asserts": [
    {
      "check": "noErrors",
      "source": "BoardVikings-CardGames",
      "label": "no errors from the card mod"
    },
    {
      "check": "noErrors",
      "label": "no errors from anyone"
    }
  ]
}