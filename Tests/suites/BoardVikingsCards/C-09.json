{
  "name": "C-09 giant card: one piece, starts on its back, face can be changed and is saved",
  "steps": [
    {
      "do": "teleport",
      "x": -6,
      "z": -8.5,
      "yaw": 218
    },
    {
      "do": "setconfig",
      "guid": "com.drakemods.serverteams",
      "values": {
        "4 Visuals/TeamGlow": false
      }
    },
    {
      "do": "give",
      "prefab": "ArmorLeatherLegs",
      "equip": true
    },
    {
      "do": "give",
      "prefab": "ArmorLeatherChest",
      "equip": true
    },
    {
      "do": "invoke",
      "method": "Cards.Table.TableTestApi.TestWearVisor",
      "args": []
    },
    {
      "do": "spawn",
      "prefab": "Card_Giant",
      "dz": 4,
      "as": "g"
    },
    {
      "do": "wait",
      "seconds": 1
    },
    {
      "do": "invoke",
      "method": "Cards.Giant.GiantCardApi.TestFace",
      "args": []
    },
    {
      "do": "check",
      "check": "lastResult",
      "label": "a new giant card shows its back",
      "expect": "back"
    },
    {
      "do": "invoke",
      "method": "Cards.Giant.GiantCardApi.TestSetFace",
      "args": [
        "S7"
      ]
    },
    {
      "do": "check",
      "check": "lastResult",
      "label": "face set",
      "expect": true
    },
    {
      "do": "wait",
      "seconds": 1
    },
    {
      "do": "invoke",
      "method": "Cards.Giant.GiantCardApi.TestFace",
      "args": []
    },
    {
      "do": "check",
      "check": "lastResult",
      "label": "the face is the 7 of Spades",
      "expect": "S7"
    },
    {
      "do": "lookAt",
      "target": "g",
      "distance": 3
    },
    {
      "do": "wait",
      "seconds": 0.5
    },
    {
      "do": "screenshot",
      "name": "giant-card",
      "clean": true
    }
  ],
  "asserts": [
    {
      "check": "objectNear",
      "target": "Card_Giant",
      "radius": 30,
      "label": "giant card placed"
    },
    {
      "check": "noErrors",
      "source": "BoardVikings-CardGames",
      "label": "no errors from the card mod"
    },
    {
      "check": "noErrors",
      "label": "no errors from anyone"
    }
  ]
}